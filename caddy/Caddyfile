# TLS in front of ARMOR Studio (compose profile "tls").
# Copyright (C) 2026 JuanenRac (Electro Hobby 3D). GPL-3.0-or-later.
#
# The certificate comes from Caddy's own local certificate authority (`tls internal`) and is issued
# for ARMOR_TLS_HOST (default "localhost"): browse to https://<that name>:8443, and set the name in
# .env to the host name the devices use. Install the authority's root certificate (in the proxy-data
# volume, pki/authorities/local/root.crt) on every device that opens Studio. Studio proxies /api/ to
# the server, so this one address serves the console and the API.
{
	auto_https disable_redirects
	default_sni {$ARMOR_TLS_HOST:localhost}
}

# ARMOR_TLS_ISSUER: "internal" (the default) is the local authority above. For a name on the Internet (see docs/REMOTE_ACCESS.md) put your e-mail address there: Caddy then asks Let's
# Encrypt for a real certificate by itself and renews it; that needs this host's ports 80 and 443 reachable from the Internet (ARMOR_TLS_PORT=443, ARMOR_TLS_HTTP_PORT=80).
https://{$ARMOR_TLS_HOST:localhost}:{$ARMOR_TLS_PORT:8443} {
	tls {$ARMOR_TLS_ISSUER:internal}
	encode gzip
	header {
		# HSTS belongs to a host name, not to a port: with the default name "localhost" a long value would make the browser refuse plain http://localhost:<any port> (Studio of
		# development, the other local programs) for as long as it lasts. The default is five minutes; raise ARMOR_TLS_HSTS (seconds) for a host name that only ever serves https.
		Strict-Transport-Security "max-age={$ARMOR_TLS_HSTS:300}"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy studio:80
}
