# TLS in front of ARMOR Studio (compose profile "tls").
# Copyright (C) 2026 JuanenRac (Electro Hobby 3D). GPL-3.0-or-later.
#
# The certificate comes from Caddy's own local certificate authority (`tls internal`) and is issued
# for ARMOR_TLS_HOST (default "localhost"): browse to https://<that name>:8443, and set the name in
# .env to the host name the devices use. Install the authority's root certificate (in the proxy-data
# volume, pki/authorities/local/root.crt) on every device that opens Studio. Studio proxies /api/ to
# the server, so this one address serves the console and the API.
{
	auto_https disable_redirects
	default_sni {$ARMOR_TLS_HOST:localhost}
}

https://{$ARMOR_TLS_HOST:localhost}:8443 {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy studio:80
}
