# Shell scripts must keep LF line endings on every platform.

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Files that the shell scripts read line by line (grep -x) must not turn into CRLF on Windows checkouts.
mosquitto/* text eol=lf
caddy/* text eol=lf
scripts/*.acl text eol=lf

# Two pull requests that add an entry to the CHANGELOG at the same place do not conflict: git keeps both entries when it merges or rebases.
CHANGELOG.md merge=union
CHANGELOG_*.md merge=union
CHANGELOG.*.md merge=union
