# A.R.M.O.R. compose environment. Never commit a populated .env.
# Run scripts/generate_secrets.sh to create one with random values instead of editing this by hand.
ARMOR_INGEST_TOKEN=replace-with-a-long-random-token
ARMOR_CONTROL_TOKEN=replace-with-a-different-long-random-token
ARMOR_OPERATOR_TOKEN=replace-with-a-third-long-random-token
# Encrypts camera passwords; keep it stable and back it up separately from the data volume.
ARMOR_CAMERA_CONFIG_KEY=replace-with-a-long-random-key
ARMOR_STUDIO_USERNAME=admin
ARMOR_STUDIO_PASSWORD=replace-with-at-least-12-characters
ARMOR_MQTT_USERNAME=armor-server
ARMOR_MQTT_PASSWORD=replace-with-broker-password
# The address the browser uses for Studio. With the TLS profile set it to https://<ARMOR_TLS_HOST>:8443 (otherwise the login is refused for its origin); the cookie then is Secure by itself.
ARMOR_PUBLIC_ORIGIN=http://127.0.0.1:8088
# Leave empty to follow the https/http of ARMOR_PUBLIC_ORIGIN; 1 or 0 force it.
ARMOR_COOKIE_SECURE=
# The address Studio's port (and with it the API: the wall panel, the phones and the network node use it) is published on: loopback by default; the address of the clients' network to reach it.
ARMOR_STUDIO_BIND=127.0.0.1
# The address the broker's port (1883) is published on: loopback by default; the address of the field network's interface for the nodes to reach it.
ARMOR_MQTT_BIND=127.0.0.1
# Alarm output. The dwell time is how long two targets must persist before the alert is high.
ARMOR_ALERT_DWELL_MS=2000
# How many targets at once make an alert high while armed (1: a lone intruder counts; 2 ignores a single target).
ARMOR_ALERT_MIN_TARGETS=1
# Set to required so that nobody can disarm without the PIN of a user (an administrator sets the PINs in Studio, Configuration > Users). Reaches the server container as it is here.
ARMOR_DISARM_PIN=
# Optional, all reach the server container as they are here (empty: the server's own default). See ARMOR-SERVER's README for what each does.
ARMOR_ALERT_LANGUAGE=es
ARMOR_ALARM_COMMANDS=
ARMOR_ELECTRICAL_SWITCHING=
ARMOR_CONTROL_DISARM=
ARMOR_INGEST_STRICT=
ARMOR_HA_DISCOVERY=
ARMOR_HA_DISCOVERY_PREFIX=homeassistant
ARMOR_TELEGRAM_BOT_TOKEN=
ARMOR_TELEGRAM_CHAT_IDS=
ARMOR_NTFY_URL=
ARMOR_NTFY_TOKEN=
# Which proxies in front of the server may say who the client is (a number, addresses, subnets or names such as uniquelocal). The default trusts the containers' private network, where Studio's proxy is.
ARMOR_TRUST_PROXY=uniquelocal
# Using the server from outside the house (empty: the server's own default). What counts as the house and as the VPN, whether the second factor is demanded from outside (off, remote,
# always), what a session from outside may do (full, operate, view) and how long it lives. Details: ARMOR-SERVER docs/REMOTE_ACCESS.md.
ARMOR_LOCAL_NETWORKS=
ARMOR_VPN_NETWORKS=
ARMOR_TOTP_REQUIRED=
ARMOR_REMOTE_POLICY=
ARMOR_REMOTE_SESSION_TTL_MS=
ARMOR_REMOTE_IDLE_MS=
ARMOR_ELEVATION_MS=
# Optional: POST every alarm (JSON, signed with X-Armor-Signature: sha256=HMAC) to this URL.
ARMOR_ALERT_WEBHOOK_URL=
ARMOR_ALERT_WEBHOOK_SECRET=
# Optional TLS profile: the address Caddy listens on (keep it on loopback unless a firewall protects it).
ARMOR_TLS_BIND=127.0.0.1
# The name the TLS certificate is issued for; browse to https://<this name>:8443.
ARMOR_TLS_HOST=localhost
# Seconds the browser is told to keep using https for that name (HSTS): five minutes until you are sure; raise it for a host name that only ever serves https.
ARMOR_TLS_HSTS=300
# "internal": Caddy's own local authority (install its root certificate on each device). For a name on the Internet put your e-mail address: a real certificate is asked for and renewed by itself.
ARMOR_TLS_ISSUER=internal
# The port the console is reached by (443 for a name on the Internet) and the port 80 the authority checks; bind to 0.0.0.0 (ARMOR_TLS_BIND) when the router forwards them.
ARMOR_TLS_PORT=8443
ARMOR_TLS_HTTP_PORT=8081
