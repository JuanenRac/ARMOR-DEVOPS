# A.R.M.O.R. compose environment. Never commit a populated .env.
# Run scripts/generate_secrets.sh to create one with random values instead of editing this by hand.
ARMOR_INGEST_TOKEN=replace-with-a-long-random-token
ARMOR_CONTROL_TOKEN=replace-with-a-different-long-random-token
ARMOR_OPERATOR_TOKEN=replace-with-a-third-long-random-token
# Encrypts camera passwords; keep it stable and back it up separately from the data volume.
ARMOR_CAMERA_CONFIG_KEY=replace-with-a-long-random-key
ARMOR_STUDIO_USERNAME=admin
ARMOR_STUDIO_PASSWORD=replace-with-at-least-12-characters
ARMOR_MQTT_USERNAME=armor-server
ARMOR_MQTT_PASSWORD=replace-with-broker-password
# The address the browser uses for Studio. Set https://... and ARMOR_COOKIE_SECURE=1 behind a TLS proxy.
ARMOR_PUBLIC_ORIGIN=http://127.0.0.1:8088
ARMOR_COOKIE_SECURE=0
